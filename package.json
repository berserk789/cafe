{
  "name": "cafe",
  "version": "1.0.0",
  "description": "Cafe",
  "main": "main.js",
  "author": "cafe",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.cafe.app",
    "productName": "Cafe",
    "files": ["main.js", "preload.js", "index.html"],
    "win": { "target": "nsis" },
    "nsis": { "artifactName": "Cafe-Setup.exe", "oneClick": true, "deleteAppDataOnUninstall": false }
  }
}
